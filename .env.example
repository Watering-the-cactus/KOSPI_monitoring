# 로컬 테스트용 예시 파일. 실제 값을 채운 뒤 .env 로 복사해서 쓰고,
# .env 자체는 git에 커밋하지 마세요 (.gitignore에 이미 등록되어 있습니다).
# GitHub Actions에서는 이 값들을 repo secrets로 등록해서 사용합니다.

# KRX 정보데이터시스템 (data.krx.co.kr) - 아이디/비밀번호 직접 가입 필요 (간편가입 불가)
KRX_ID=
KRX_PW=

# 발송용 개인 Gmail (2단계 인증 + 앱 비밀번호)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
RECIPIENT_EMAIL=kim.younghyun@bcg.com

NAVER_API_KEY=

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=

# GitHub Pages로 게시된 대시보드 기본 URL (예: https://<username>.github.io/<repo>)
DASHBOARD_BASE_URL=
